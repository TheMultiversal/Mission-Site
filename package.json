{
  "dependencies": {
    "vite": "^7.3.1",
    "proper-lockfile": "^4.1.2"
  },
  "scripts": {
    "generate-checklist": "node ./scripts/generate-checklist.js",
    "toggle": "node ./scripts/toggle-check.js",
    "status": "node ./scripts/check-status.js",
    "generate-batch": "node ./scripts/generate-batch.js",
    "toggle-range": "node ./scripts/toggle-range.js",
    "set-range": "node ./scripts/set-range.js",
    "test-race": "node ./scripts/test-race.js",
    "test-race-loop": "node ./scripts/test-race-loop.js",

    "lint:md": "markdownlint '**/*.md' || true",
    "check-links": "markdown-link-check --config .markdown-link-check.json '**/*.md' || true",
    "spell": "cspell '**/*.md' || true",
    "audit": "npm audit --audit-level=moderate || true",

    "ci": "npm run lint:md && npm run check-links && npm run spell && npm run audit"
  }
}
